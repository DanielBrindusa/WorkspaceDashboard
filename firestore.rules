rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function primaryOwner() {
      return googleUser() && exists(/databases/$(database)/documents/config/owner)
        && get(/databases/$(database)/documents/config/owner).data.uid == request.auth.uid;
    }
    function approvedForPrimary() {
      return googleUser() && exists(/databases/$(database)/documents/grants/$(request.auth.uid))
        && get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.active == true
        && (get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.permanent == true
          || (get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.expiresAt is timestamp
            && request.time < get(/databases/$(database)/documents/grants/$(request.auth.uid)).data.expiresAt));
    }
    function invitedForPrimary() {
      return googleUser()
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.active == true
        && (get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.permanent == true
          || (get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.expiresAt is timestamp
            && request.time < get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.expiresAt));
    }
    function canReadWorkspace(workspaceUid) {
      return googleUser() && (request.auth.uid == workspaceUid
        || (exists(/databases/$(database)/documents/config/owner)
          && workspaceUid == get(/databases/$(database)/documents/config/owner).data.uid
          && (approvedForPrimary() || invitedForPrimary())));
    }
    match /config/owner {
      allow get: if googleUser();
      allow list, write: if false;
    }
    // Requests and grants apply only to the primary owner's dashboard.
    match /requests/{uid} {
      allow get: if primaryOwner() || googleUser() && request.auth.uid == uid;
      allow list: if primaryOwner();
      allow create: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','name','status','requestedAt'])
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time;
      allow update: if primaryOwner() || googleUser() && request.auth.uid == uid
        && resource.data.status != 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','name','status','requestedAt'])
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time;
      allow delete: if primaryOwner();
    }
    match /grants/{uid} {
      allow get: if primaryOwner() || googleUser() && request.auth.uid == uid;
      allow list, write: if primaryOwner();
    }
    match /invites/{email} {
      allow get: if primaryOwner() || googleUser() && request.auth.token.email.lower() == email;
      allow list: if primaryOwner();
      allow create, update: if primaryOwner() && email == email.lower()
        && request.resource.data.email == email;
      allow delete: if primaryOwner();
    }
    match /workspaces/{workspaceUid}/records/{recordId} {
      allow read: if canReadWorkspace(workspaceUid);
      allow create, update: if googleUser() && request.auth.uid == workspaceUid
        && request.resource.data.id == recordId;
      allow delete: if googleUser() && request.auth.uid == workspaceUid;
    }
    match /workspaces/{workspaceUid}/meta/{metaId} {
      allow read, write: if googleUser() && request.auth.uid == workspaceUid;
    }
    // Owner-only access to the previous data location for safe migration.
    // Shared viewers cannot access legacy records even if they have a grant.
    match /records/{recordId} {
      allow read, delete: if primaryOwner();
      allow create, update: if primaryOwner() && request.resource.data.id == recordId;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
